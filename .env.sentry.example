# Copy to .env.sentry (git-ignored) for `pnpm run deploy`.
# Auth token: Sentry → Settings → Auth Tokens (org token with "project:releases" / source map upload scope).
SENTRY_AUTH_TOKEN=
SENTRY_ORG=walknicely
SENTRY_API_PROJECT=jewel-finder-api
SENTRY_WEB_PROJECT=jewel-finder-web
# DSN of the web project, baked into the web build.
VITE_SENTRY_DSN=
