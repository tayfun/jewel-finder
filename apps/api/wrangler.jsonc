{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "jewel-finder",
	"main": "src/index.ts",
	"compatibility_date": "2026-10-01",
	"compatibility_flags": [
		"nodejs_compat"
	],
	// Production lives at stockandlist.com (a Custom Domain: wrangler creates the DNS record and certificate).
	"routes": [
		{
			"pattern": "stockandlist.com",
			"custom_domain": true
		}
	],
	// Kept on: extension builds up to 0.8.x call the API at jewel-finder.tayfun-sen.workers.dev.
	"workers_dev": true,
	// The built web app is served from the same Worker. /api and /images hit the Worker first.
	"assets": {
		"directory": "../web/dist",
		"binding": "ASSETS",
		"not_found_handling": "single-page-application",
		"run_worker_first": [
			"/api/*",
			"/images/*"
		]
	},
	"durable_objects": {
		"bindings": [
			{
				"name": "ACCOUNT",
				"class_name": "AccountDO"
			},
			{
				// Single instance: every account's counts + admin flags, for the admin dashboard.
				"name": "DIRECTORY",
				"class_name": "DirectoryDO"
			}
		]
	},
	"migrations": [
		{
			"tag": "v1",
			"new_sqlite_classes": [
				"AccountDO"
			]
		},
		{
			"tag": "v2",
			"new_sqlite_classes": [
				"DirectoryDO"
			]
		}
	],
	"r2_buckets": [
		{
			"binding": "IMAGES",
			"bucket_name": "jewel-finder-images"
		}
	],
	// Deployed version id; Sentry uses it as the release for every event.
	"version_metadata": {
		"binding": "CF_VERSION_METADATA"
	},
	// Secrets: JWT_SECRET, GEMINI_API_KEY, SENTRY_DSN, and ADMIN_EMAILS (comma-separated emails that are
	// always admins; they can make others admin from /admin).
	// Model used for "Auto-fill from photos", and the one tried when it is overloaded.
	// The API key is the GEMINI_API_KEY secret.
	"vars": {
		"GEMINI_MODEL": "gemini-3.8-flash",
		"GEMINI_FALLBACK_MODEL": "gemini-3.5-flash",
		// Overridden to "development" in .dev.vars. The DSN is the SENTRY_DSN secret.
		"SENTRY_ENVIRONMENT": "production"
	},
	"observability": {
		"enabled": true
	}
}