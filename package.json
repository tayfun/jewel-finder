{
  "name": "stock-and-list",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.0.0",
  "scripts": {
    "dev": "concurrently -k -n api,web -c blue,green \"pnpm --filter @jf/api dev\" \"pnpm --filter @jf/web dev\"",
    "build": "pnpm --filter @jf/web build && pnpm --filter @jf/extension build",
    "build:ext": "pnpm --filter @jf/extension build",
    "build:ext:prod": "pnpm --filter @jf/extension build:prod",
    "release:ext": "pnpm --filter @jf/extension release",
    "deploy": "node scripts/deploy.mjs",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test"
  },
  "devDependencies": {
    "concurrently": "^10.0.6",
    "typescript": "^7.0.2"
  }
}
